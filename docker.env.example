# Copy this file to .env on the Linux server and replace every secret.
COMPOSE_PROJECT_NAME=company-portal
POSTGRES_DB=company_portal
POSTGRES_USER=company_portal_app
# Use a long URL-safe value (letters, numbers, underscore and hyphen).
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret
# Development-only seed credentials. Set real values in an untracked local .env before running pnpm seed.
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
# Optional initial password for newly created/imported employees. When blank, the API generates a random value.
INITIAL_EMPLOYEE_PASSWORD=
# Exact comma-separated browser origins. Do not add spaces.
WEB_ORIGIN=https://portal.example.com,https://employee.example.com
# Use 127.0.0.1 when Nginx/Caddy on the same server is the only public entry point.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
MOBILE_BIND_ADDRESS=127.0.0.1
MOBILE_PORT=8081
