# Copy this file to .env on the Linux server and replace every secret.
POSTGRES_DB=company_portal
POSTGRES_USER=company_portal_app
# Use a long URL-safe value (letters, numbers, underscore and hyphen).
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret
# Exact comma-separated browser origins. Do not add spaces.
WEB_ORIGIN=https://portal.example.com,https://employee.example.com
WEB_PORT=8080
MOBILE_PORT=8081
