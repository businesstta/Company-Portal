{
  "name": "company-portal",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:api": "pnpm --filter @company-portal/api dev",
    "dev:web": "pnpm --filter @company-portal/web dev",
    "dev:mobile": "pnpm --filter @company-portal/mobile dev",
    "start:api": "pnpm --filter @company-portal/api start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "check:responsive": "node scripts/check-responsive.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "check": "pnpm lint && pnpm check:responsive && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
