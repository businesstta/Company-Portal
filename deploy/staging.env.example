# Copy to /opt/ess-portal-staging/.env. Never commit the real .env file.
COMPOSE_PROJECT_NAME=ess-portal-staging
POSTGRES_DB=ess_portal_staging
POSTGRES_USER=ess_staging_app
POSTGRES_PASSWORD=replace-with-a-strong-unique-staging-password
JWT_SECRET=replace-with-output-from-openssl-rand-hex-64
WEB_ORIGIN=https://dev-ess.example.com,https://dev-employee.example.com
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8180
MOBILE_BIND_ADDRESS=127.0.0.1
MOBILE_PORT=8181
