# Copy to /opt/ess-portal-production/.env. Never commit the real .env file.
COMPOSE_PROJECT_NAME=ess-portal-production
POSTGRES_DB=ess_portal_production
POSTGRES_USER=ess_production_app
POSTGRES_PASSWORD=replace-with-a-strong-unique-production-password
JWT_SECRET=replace-with-output-from-openssl-rand-hex-64
WEB_ORIGIN=https://ess.example.com,https://employee.example.com
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8280
MOBILE_BIND_ADDRESS=127.0.0.1
MOBILE_PORT=8281
